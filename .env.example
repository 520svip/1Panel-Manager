# ============================================
# 1Panel Manager 环境配置模板
# 复制为 .env 并按需修改；修改后需重启服务生效
# ============================================

# 运行环境：production（生产）/ development（开发）/ test（测试演示）。
# 生产模式（PM2、npm start）下 Express 直接托管 dist/，需先 npm run build；
# 开发模式（npm run dev）会自动以 NODE_ENV=development 启动，无需修改此项；
# 测试演示模式（NODE_ENV=test 或 npm run test）与生产一样托管 dist/ 并监听对外端口，
#   但会对面板 API Key 打掩码（不可还原）、登录页显示默认密码提示、禁止修改密码，
#   适合部署在可对外访问的服务器上做演示，避免泄露真实密钥。
NODE_ENV=production

# 对外访问端口（生产模式即 Express 端口；开发模式即 Vite 端口）
PORT=3000

# 开发模式：Vite 开发服务器端口（浏览器访问的端口）
VITE_PORT=3000

# 开发模式：内部后端端口（Vite 自动代理 /api 到这里，无需手动访问）
BACKEND_PORT=3001

# 服务监听地址（默认 0.0.0.0 监听所有网卡；仅本机访问可设为 127.0.0.1）
HOST=0.0.0.0

# 首次启动时初始化的后台密码（仅当数据库无密码时生效，之后请在「设置」中修改）
DEFAULT_PASSWORD=admin123

# 后台会话有效期（小时），默认 24
SESSION_TTL_HOURS=24

# 请求 1Panel API 的超时时间（毫秒），默认 8000
PANEL_TIMEOUT_MS=8000

# 可选：跨域白名单（逗号分隔）。留空表示允许任意来源。
# CORS_ORIGINS=http://localhost:3000
