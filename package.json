{
  "name": "1panel-manager",
  "version": "1.0.0",
  "description": "集中管理多个 1Panel 面板的控制面板",
  "author": "nameless",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/520svip/1panel-manager.git"
  },
  "bugs": {
    "url": "https://github.com/520svip/1panel-manager/issues"
  },
  "homepage": "https://github.com/520svip/1panel-manager#readme",
  "type": "module",
  "main": "start.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node start.js",
    "test": "cross-env NODE_ENV=test node start.js",
    "dev": "concurrently -n backend,vite -c blue,green \"npm:dev:server\" \"npm:dev:vite\"",
    "dev:server": "cross-env NODE_ENV=development node start.js",
    "dev:vite": "vite",
    "stop": "node stop.js",
    "build": "vite build",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:logs": "pm2 logs 1panel-manager",
    "pm2:monit": "pm2 monit"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "cross-env": "^7.0.3",
    "express": "^4.21.2",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^9.2.4",
    "vite": "^5.4.21",
    "vue": "^3.5.41"
  }
}
